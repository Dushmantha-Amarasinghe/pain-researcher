# Which search service to use, either 'duckduckgo', 'tavily', 'perplexity', Searxng
SEARCH_API='duckduckgo'
# For Searxng search, defaults to http://localhost:8888
SEARXNG_URL=

# Web Search API Keys (choose one or both)
TAVILY_API_KEY=tvly-xxxxx      # Get your key at https://tavily.com
PERPLEXITY_API_KEY=pplx-xxxxx  # Get your key at https://www.perplexity.ai

# LLM Configuration
LLM_PROVIDER=lmstudio          # Options: ollama, lmstudio
LOCAL_LLM=qwen_qwq-32b         # Model name in LMStudio/Ollama
LMSTUDIO_BASE_URL=http://localhost:1234/v1  # LMStudio OpenAI-compatible API URL
OLLAMA_BASE_URL=http://localhost:11434 # the endpoint of the Ollama service, defaults to http://localhost:11434 if not set

MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True

# --- Pain-Point Researcher ---

# Google AI Studio key for Gemma 4 (26B + 31B). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=xxxxx

# Reddit API app credentials (script-type app). Create one at https://www.reddit.com/prefs/apps
# Optional as of the multi-source update — leave blank and remove "reddit" from
# sources.enabled in settings.yaml to run on hackernews/stackexchange only
# (both work with zero credentials, useful while Reddit access is pending approval).
REDDIT_CLIENT_ID=xxxxx
REDDIT_CLIENT_SECRET=xxxxx
REDDIT_USER_AGENT="pain-researcher/0.1 by u/your_username"

# Optional. Raises Stack Exchange's unauthenticated 300 req/day quota to
# 10,000/day. Free registration (name + description only, no OAuth) at
# https://stackapps.com/apps/oauth/register — works fine without one.
STACKEXCHANGE_API_KEY=

# Discovery mode: autonomous (default) | seed | watchlist
PAIN_RESEARCHER_DISCOVERY_MODE=autonomous
# Only used when discovery mode is "seed"
PAIN_RESEARCHER_SEED_NICHE=
# Only used when discovery mode is "watchlist", comma-separated subreddit names (no r/ prefix)
PAIN_RESEARCHER_SUBREDDIT_WATCHLIST=

# Path to the tunable settings file (thresholds, model profiles, scoring weights)
PAIN_RESEARCHER_SETTINGS_PATH=src/pain_researcher/settings.yaml

# If true, walks the pipeline and reports projected request/token spend without calling any LLM
PAIN_RESEARCHER_DRY_RUN=false